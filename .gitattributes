# Auto detect text files and perform LF normalization
* text=auto
*.bat text eol=crlf

# Sealed files: keep exact bytes so their SHA-256 matches SEAL.txt
spanish-check/** -text
routes/spanish-check.js -text
public/spanish-check.html -text
public/js/spanish-check.js -text
spanish-check-lc/** -text
routes/spanish-check-lc.js -text
public/spanish-listening.html -text
public/js/spanish-listening.js -text
# Shell scripts, systemd units and env files are copied to a Linux VM: always LF, even in a Windows checkout.
deploy/beta/* text eol=lf
