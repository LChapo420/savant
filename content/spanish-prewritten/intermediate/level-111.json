      "purpose": "States negation as a single placement rule.",
      "data": {
        "tag": "Unit 2.9",
        "ruleName": "No before the verb",
        "anchor": "To make a sentence negative, put no directly in front of the verb.",
        "prerequisites": [
          "Entiendo. → No entiendo. (I understand. → I don't understand.)",
          "Tengo tiempo. → No tengo tiempo. (I have time. → I don't have time.)",
          "There is no extra word for \"don't\" or \"doesn't\"."
        ]
