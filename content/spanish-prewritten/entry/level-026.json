      "block": "Theory_RuleCard",
      "purpose": "Teaches the one change uno makes before a noun.",
      "data": {
        "tag": "Grammar note",
        "ruleName": "Uno, un, una",
        "anchor": "When you count, say uno; in front of a noun, uno shortens to un for masculine words and changes to una for feminine words.",
        "prerequisites": [
          "Counting: uno, dos, tres.",
          "Masculine noun: un café (one coffee, a coffee).",
          "Feminine noun: una pregunta (one question, a question).",
          "The other numbers never change: dos cafés, dos preguntas."
        ]
      },
