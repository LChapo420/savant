# Copy to .env for local development. Set the same keys in the host's dashboard
# in production.

# Signs session cookies. The server refuses to start in production with fewer
# than 32 characters, because a guessable key lets anyone forge a login cookie
# for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# production turns on HTTPS-only cookies, HSTS, the HTTP-to-HTTPS redirect, and
# the SESSION_SECRET length requirement above.
NODE_ENV=development

PORT=6767

# Accounts that can open the admin panel (/admin): every learner's scorecard,
# learning-style summary, survey answers and progress. Comma separated. The
# owner by default. Sign-up does not verify email addresses, so register the
# owner account yourself before anyone else can.
ADMIN_EMAILS=the.landon.d@gmail.com

# How many proxies sit in front of the app, which decides whose address the app
# believes a request came from. Leave unset locally: trusting a forwarded header
# when nothing is forwarding lets anyone claim any IP and slip past rate limits.
# TRUST_PROXY=1


# ── AI provider ────────────────────────────────────────────────────────────
# Blanket default for general AI work: mimo, openrouter, gemini, or anthropic.
# Placement is routed separately with AI_PROVIDER_PLACEMENT below.
AI_PROVIDER=mimo

# The two kinds of work can run on different vendors, and usually should.
# Deep work (writing a lesson, reading a learner's style out of a session) is
# judged on the result and can afford a slow, strong model. Chat is judged on
# whether it feels like a conversation, so it goes wherever first-token latency
# is lowest — measured, not assumed. MiMo Singapore costs ~220ms in network
# alone from Europe/US before the model thinks, so chat goes to OpenRouter's
# free Qwen route instead.
#
# Three routes, and the backup for each is a choice rather than whatever happens
# to be configured next:
#
#   fast   chat: the coach, question help, clarification, deeper understanding.
#          Qwen, backed by Gemini flash-lite — the backup is picked for latency,
#          because a slow conversation is a broken one.
#   deep   everything else that uses AI: lessons and lesson modification, session
#          analysis, reading a failed quiz, essay and project ideation. MiMo pro,
#          backed by Qwen.
#   regen  remaking a failed checkpoint's questions: same level, same topics,
#          questions the learner has not seen. MiMo flash — bulk authoring
#          against a fixed spec, with someone waiting on it.
AI_PROVIDER_FAST=openrouter
AI_PROVIDER_FAST_FALLBACK=gemini,mimo
AI_PROVIDER_DEEP=mimo
AI_PROVIDER_DEEP_FALLBACK=openrouter,gemini
AI_PROVIDER_REGEN=openrouter
AI_PROVIDER_REGEN_FALLBACK=mimo,gemini
# Whole-subject placement quizzes are pinned to Modelflare with no fallback.
AI_PROVIDER_PLACEMENT=modelflare
# GLM 5.3 Flash rewrites failed quizzes; MiMo flash (MIMO_MODEL_REGEN) is its backup.
OPENROUTER_MODEL_REGEN=z-ai/glm-5.3-flash

# ── Writing a level for one learner (the learning scorecard) ─────────────────
# The per-user level editor — the one prompt that rewrites the creator's lesson
# page around a learner's scorecard, survey and feedback — and the read of every
# finished level (with their feedback, or their wrong answers and timings) into
# their record and scorecard. DeepSeek V4.1 Flash on OpenRouter
# (the model the base lessons are generated with), backed by MiMo V2.6 Pro, and
# nothing else: a third vendor's page is a page the checks throw away.
AI_PROVIDER_PERSONALIZE=openrouter
AI_PROVIDER_PERSONALIZE_FALLBACK=mimo
# OPENROUTER_MODEL_PERSONALIZE=deepseek/deepseek-v4.1-flash
# MIMO_MODEL_PERSONALIZE=mimo-v2.6-pro

# Share of levels served as the shared page on purpose, so `npm run
# scorecard:report` can show whether tailored pages beat it.
PERSONALIZE_HOLDOUT=0.1
# Share of levels that deliberately try one way of teaching (examples first or
# rule first, an analogy or none, ...) the scorecard is not yet sure about.
PERSONALIZE_EXPERIMENT_RATE=0.35

# The after-level read. It waits this long after a level ends for the learner
# to leave feedback, then reads the level (with their feedback if they left any).
RECORD_FEEDBACK_WAIT_MS=120000
# Each read moves a stat by at most 1 point. A bigger move (the average of what
# was asked, at most 25) needs big suggestions in one direction from this many
# different levels.
SCORECARD_BIG_AFTER=11
# A recommendation (a read that disagreed with something solid) is reviewed
# against everything known about the learner once this many reads support it.
RECORD_REVIEW_AT=3

# ── OpenRouter ─────────────────────────────────────────────────────────────
# Key from https://openrouter.ai/keys. OpenAI-compatible endpoint, so only the
# key and the model slugs are needed. This is the chat lane — the coach, the
# explainer, grading a short answer — and the default route is free.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Slugs are configuration because OpenRouter adds and retires routes. Run
#   npm run ai:models
# to print exactly what your key can reach.
OPENROUTER_MODEL_FAST=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_DEEP=qwen/qwen3.8-27b:free

# Left empty on purpose: the obvious fallback for a spent :free route is the
# same model without the suffix, which is the same request with a bill attached.
# Empty means a spent daily quota hands the work to the next provider.
OPENROUTER_MODEL_DAILY_FALLBACK=

# Optional, and only for attribution on the OpenRouter dashboard.
# OPENROUTER_SITE_URL=http://localhost:6767
# OPENROUTER_APP_NAME=Polymath

OPENROUTER_MIN_GAP_MS=1200
OPENROUTER_CHAT_GAP_MS=0

# ── deepseek/deepseek-v4.1-flash ────────────────────────────────────────────
# A strong reasoning model reached through OpenRouter, with a per-model profile in
# services/providers/openrouter.js: the request pinned to the `sail-research/fp4`
# upstream with no substitution allowed, and its `reasoning_details` handed back
# with each turn so a follow-up continues its own thinking rather than starting
# over. Naming the model is all it takes — nothing else has to be configured
# alongside it.
#
# It is not a lane's model by default. To use it, put the slug in one of the two
# lines above:
#
#   OPENROUTER_MODEL_FAST=deepseek/deepseek-v4.1-flash   # as the coach
#   OPENROUTER_MODEL_DEEP=deepseek/deepseek-v4.1-flash   # as the deep lane
#
# A separate key is supported and optional: the general OPENROUTER_API_KEY above
# already reaches this model, so set this only to keep the route's quota and spend
# on its own account. It is then used for this one model and for nothing else.
OPENROUTER_DEEPSEEK_API_KEY=

# ── Xiaomi MiMo ────────────────────────────────────────────────────────────
# Key from the MiMo console: https://mimo.mi.com
# OpenAI-compatible endpoint, so only the key and the model ids are needed.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Two models, two jobs. Pro does the work where judgment shows up in the
# result — writing a lesson, reading a learner's style out of a session,
# building the retention set. Flash does the work someone is waiting on:
# the coach, the explainer, grading a short answer.
MIMO_MODEL_DEEP=mimo-v2.6-pro
MIMO_MODEL_FAST=mimo-v2.6-flash

# Remaking a failed Master or Grand Master quiz. A 15-question quiz goes out as
# two concurrent batches and takes about 18 seconds, which is why it is written
# while the learner is still reading the recap rather than when they click retry.
MIMO_MODEL_REGEN=mimo-v2.6-flash

# Modelflare placement quiz. Create a key in a group that can serve the model.
# Verify the exact model ID against that key with `npm run ai:models -- --placement`.
MODELFLARE_API_KEY=
MODELFLARE_BASE_URL=https://modelflare.dev/v1
MODELFLARE_MODEL_PLACEMENT=gpt-6.1-sol

# How long a retry will wait on freshly written questions before filling in from
# the bank. A ceiling, not a target — it only applies when the prefetch did not
# land, which means a vendor was down.
CHECKPOINT_REGEN_WAIT_MS=20000

# Where to go when a model has spent its DAILY quota (per-minute limits are
# waited out instead).
MIMO_MODEL_DAILY_FALLBACK=mimo-v2.6-flash

# Google AI Studio key: https://aistudio.google.com/apikey
# Without any key the site still runs end to end on the deterministic content
# bank — questions are generated procedurally and sessions are analyzed by the
# rule-based analyst. The coach is the one feature that needs a model.
# Keep the real key in .env, which is gitignored. This file is committed.
GEMINI_API_KEY=

# Model ids are configuration because Google renames and rotates them. Run
#   npm run ai:models
# to print exactly what your key can reach, then paste the id you want here.
# Common ids: gemini-flash-latest, gemini-2.5-flash, gemini-2.5-pro.
GEMINI_MODEL=gemini-3.5-flash-lite

# The chat lane: the coach, the explainer, and grading. This is the single
# biggest lever on how fast the tutor feels, because a learner is sitting there
# waiting for it. Measured on the free tier, one coaching turn takes roughly
# 0.8s on flash-lite, 2.3s on a mid model, and 30s on a large one — so this
# defaults to the small model rather than to GEMINI_MODEL.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Calls run in two lanes. Background work (writing questions, analyzing a
# session) is spaced out to stay inside the free tier's per-minute limit; chat
# has its own lane with a small gap so it never queues behind an authoring call.
GEMINI_MIN_GAP_MS=1200
GEMINI_CHAT_GAP_MS=150

# Where to go when a model has spent its DAILY quota (not the per-minute one):
# the per-minute limit is waited out, a daily limit is not, so that model is set
# aside until it resets and this one answers instead.
GEMINI_MODEL_DAILY_FALLBACK=gemini-3.1-flash-lite

# Models to try when the chosen one answers 503 "high demand", runs out of
# quota, or is not available to this key. The newest model is also the most
# contended, so a quieter fallback is the difference between a coach that
# usually works and one that usually drops to the bank. Comma separated; set to
# empty to disable. The chat list is ordered by measured latency.
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_MODEL_FAST_FALLBACK=gemini-3.1-flash-lite,gemini-flash-lite-latest

# Anthropic, used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AI_MODEL_AUTHOR=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5

# Making lessons factual: with this key set, Claude researches each lesson's facts
# on the web before GLM writes it, then verifies every claim after (with sources);
# what fails is fixed or removed, and a lesson is served only once it is verified.
# This key is used for that and nothing else (not as a chat fallback, unlike
# ANTHROPIC_API_KEY above). Roughly $0.15-0.40 a lesson on Sonnet 5.5 with search.
# Check it works: node scripts/check-fact-key.js
FACT_CHECK_ANTHROPIC_KEY=
# Needed when the key is not scoped to a workspace (console.anthropic.com >
# Settings > Workspaces; the ID starts with wrkspc_).
FACT_CHECK_ANTHROPIC_WORKSPACE=
# FACT_CHECK_MODEL=claude-sonnet-5-5
# Which verifier: thorough (default with the key: free checks as hints, Sonnet on every claim, repairs,
# full re-reads), sonnet (one Sonnet read, cheaper), cascade (cheapest, weakest). The local checkers it uses:
#   ..\fact-venv\Scripts\python.exe -I tools/fact-checkers/server.py
# FACT_PIPELINE=thorough
# BLOCK_FACT_GATE=0 serves lessons without verification even with the key set.

# Per-user daily ceilings. Past either one the learner silently falls back to
# the bank instead of the request failing. Cents matter on a paid API; the call
# count is what actually bounds a free tier.
AI_DAILY_CENTS_PER_USER=25
AI_DAILY_CALLS_PER_USER=120

# ── GLM 5.3 Flash (z-ai/glm-5.3-flash) ────────────────────────────────────
# Paste your OpenRouter key below. That is all it takes — the lines underneath
# already put GLM to work writing your lessons, levels and deep work.
OPENROUTER_GLM_API_KEY=
OPENROUTER_LESSON_MODEL=z-ai/glm-5.3-flash
OPENROUTER_MODEL_PERSONALIZE=z-ai/glm-5.3-flash
OPENROUTER_MODEL_DEEP=z-ai/glm-5.3-flash
# The coach/chat lane stays on the free route; uncomment to move it to GLM too:
# OPENROUTER_MODEL_FAST=z-ai/glm-5.3-flash

# ── Block levels (docs/BLOCK-LEVELS.md) ────────────────────────────────────
# Lessons, retention checks, game levels and checkpoint quizzes are laid out and
# filled from the block library per learner: GLM 5.3 Flash, backed by MiMo V2.6
# Pro (MIMO_API_KEY). Both are already the defaults; these only override them.
# OPENROUTER_MODEL_BLOCKS=z-ai/glm-5.3-flash
# MIMO_MODEL_BLOCKS=mimo-v2.6-pro
# Every account is served block levels: standard learners (and the owner) the
# shared base versions, learners on a tailoring plan their own. "owner" narrows
# them to the owner and BASE_LESSON_ACCOUNTS.
# BLOCK_LEVELS=owner
# Standard learners only ever get base levels that were written ahead
# (npm run generate:base); only the owner, BASE_LESSON_ACCOUNTS and tailoring
# plans cause a model call. "all" lets every visit write a missing level.
# BLOCK_GENERATE=all
# Set to 1 for the owner to see tailored versions instead of the base ones.
# BLOCK_TAILOR_OWNER=1
# How long a page waits on a plan being written before saying "still writing".
# BLOCK_WAIT_MS=8000
# BLOCK_FILL_MAX_TOKENS=32000
# GLM's reasoning effort on block layouts and fill-outs. "low" cuts output tokens
# about tenfold with the same coverage; leave unset for the endpoint's default.
OPENROUTER_GLM_BLOCKS_EFFORT=low
