# /srv/savant-beta/savant-beta.env : the beta app's settings (deploy/beta/README.md, step 6).
#
# NAMES ONLY in git. Fill the values ON THE VM, never in this file, never in a chat.
# The filled file is owned root:savantbeta, mode 640.
# Quote any value that has a space or < > in it (MAIL_FROM below): systemd and the
# bin/run helper both read this file, and the shell needs the quotes.
#
# Lines already filled are fixed settings, not secrets. Lines ending in = are yours to fill.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=6767
# Exactly one proxy (Caddy) in front of the app.
TRUST_PROXY=1
# Generated on the VM by step 6; 32+ characters; the app refuses to start without it.
SESSION_SECRET=
APP_ORIGIN=https://beta.savantedu.com
ALLOWED_ORIGINS=https://beta.savantedu.com
# Your own sign-in address. ADMIN_EMAILS opens /admin; OWNER_EMAIL is the owner rule
# (config/owner.js). Both also mark the account "founder" in the real-user metrics.
ADMIN_EMAILS=
OWNER_EMAIL=

# ── Data (a fresh directory; shared/ survives every release) ──────────────────
DB_FILE=/srv/savant-beta/shared/data/db.json
SESSION_DB_FILE=/srv/savant-beta/shared/data/sessions.sqlite
BETA_INVITES_FILE=/srv/savant-beta/shared/data/beta-invites.json
MAIL_OUTBOX_DIR=/srv/savant-beta/shared/data/outbox
LOG_DIR=/srv/savant-beta/shared/logs
BACKUP_DIR=/srv/savant-beta/backups
BACKUP_MAX_AGE_DAYS=28

# ── Mail (consent emails to parents, invite emails, error alerts) ─────────────
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Savant <no-reply@send.savantedu.com>"
MAIL_REPLY_TO=
ERROR_ALERT_EMAIL=
# BREVO_API_KEY=                  only with MAIL_PROVIDER=resend,brevo (the failover)
# MAIL_ALLOW_OUTBOX=1             STOPGAP ONLY until Resend shows Verified: README "If mail is not ready"

# ── Beta gate: invite-only sign-up and sign-in ────────────────────────────────
BETA_GATE=invite
BETA_GATE_LOGIN=1
BETA_ALLOW_EMAILS=

# ── Consent ──────────────────────────────────────────────────────────────────
CONSENT_PENDING_ACCESS=limited

# ── Models for learners (NVIDIA first; there is no local model on the VM) ─────
NVIDIA_API_KEY=
OLLAMA_ENABLED=0
# AI_DAILY_CENTS_PER_USER=        per-learner spend cap per day (default 25)
# AI_DAILY_CALLS_PER_USER=        per-learner call cap per day (default 120)

# ── Real-user metrics (/admin#metrics; docs/METRICS.md) ───────────────────────
# FOUNDER_EMAILS=                 more of your own addresses, counted as founder
# TEAM_EMAIL_DOMAINS=savantedu.com    the default; addresses here count as founder
# METRICS_EXCLUDE_EMAILS=         addresses you used for testing, counted as test

# NEVER on this server (build pipeline or test-only; see curriculum-build/BETA-LAUNCH-KIT.md 2.1):
# XKIRO_*, UNOROUTER_*, OPENROUTER_GPT_SOL_API_KEY, OPENROUTER_GLM_API_KEY, DEV_TOOLS,
# BLOCK_GENERATE, BLOCK_FACT_GATE, OLLAMA_FALLBACK_ALL, CONSENT_SWEEP, DB_READONLY,
# AI_LEGACY_PROVIDERS, FACT_POOL, RESEND_API_URL, BREVO_API_URL.
