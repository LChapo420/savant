# /etc/systemd/system/savant-beta-backup.timer : nightly, 03:30 UTC.
# Persistent: a run missed while the VM was off happens at the next boot.
[Unit]
Description=Nightly Savant beta backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
