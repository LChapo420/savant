# /srv/savant/savant.env : NAMES ONLY. Fill the values on the server (chmod 600).
# Never commit the filled file. curriculum-build/BETA-LAUNCH-KIT.md section 2.1.

# Core
NODE_ENV=production
PORT=6767
TRUST_PROXY=1
SESSION_SECRET=
APP_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
ADMIN_EMAILS=
OWNER_EMAIL=

# Data (absolute paths; /srv/savant/shared survives every release, and each release links data -> shared/data)
DB_FILE=/srv/savant/shared/data/db.json
# DB_DRIVER=sqlite
# DB_SQLITE_FILE=/srv/savant/shared/data/db.sqlite
SESSION_DB_FILE=/srv/savant/shared/data/sessions.sqlite
BETA_INVITES_FILE=/srv/savant/shared/data/beta-invites.json
BACKUP_DIR=/srv/savant/backups
BACKUP_MAX_AGE_DAYS=28
LOG_DIR=/srv/savant/shared/logs
MAIL_OUTBOX_DIR=/srv/savant/shared/data/outbox

# Mail (section 3)
MAIL_PROVIDER=resend
RESEND_API_KEY=
# BREVO_API_KEY=
MAIL_FROM=Savant <no-reply@send.example.com>
MAIL_REPLY_TO=
MAIL_DAILY_CAP=100
ERROR_ALERT_EMAIL=

# Beta gate (section 4)
BETA_GATE=invite
BETA_GATE_LOGIN=1
BETA_ALLOW_EMAILS=

# Consent (curriculum-build/KIDS-CONSENT-IMPLEMENTATION.md section 8)
CONSENT_PENDING_ACCESS=limited

# Models for learners: NVIDIA first (xKiro and UnoRouter never go on this server)
NVIDIA_API_KEY=
OLLAMA_ENABLED=0
# FACT_CHECK_ANTHROPIC_KEY=      owner decision, section 1.4 (the lesson gate)
# ANTHROPIC_LEDGER_STOP_USD=     this server's own cap, if the key above is set
