+/**
+ * Skill coverage: chess, piano and basketball in the same coverage model as
+ * every other subject (services/coverage.js), per learner. Brought into the
+ * app by the staged patch skills-round3/01-skill-record from
+ * curriculum-build/staged/adaptation/skills/skill-coverage.js (the rules are
+ * unchanged); the stages and batteries are content/skill-progressions/*.json,
+ * copies of curriculum-build/staged/skills/<subject>/progression.json.
+ * curriculum-build/ADAPTIVE-COVERAGE.md section 6; SKILL-CURRICULA.md.
+ *
+ * WHAT a stage must cover is fixed, in two parts:
+ *   knowledge    the stage's grades' lesson objectives, exactly as for every
+ *                other subject: coverage.modelFor(subject, grade), proven and
+ *                kept by coverage.gate. Nothing new here.
+ *   performance  the stage's exit battery (progression.json stages[].exit
+ *                .performance): one metric per test, each with its own pass
+ *                rule (counts, Beta posterior, rating with RD, play-outs)
+ *                applied by the drill that runs the sitting. A stage that names
+ *                a retention test ("again after 7+ days") also needs that.
+ *
+ * The per-learner skill record, per metric: every sitting of its test as
+ * {at, pass, cold, source, confirmed}. The rules of SKILL-CURRICULA.md section 2,
+ * as code:
+ *   - Proof only: a metric is proven only by sittings of its test. Time spent,
+ *     lessons done and self-ratings never prove it.
+ *   - Cold only: a sitting counts when it is cold: the first sitting of that
+ *     metric on its day, at least COLD_HOURS (20) after that metric was last
+ *     practised or sat.
+ *   - Two days: proven needs cold passes on two different days, and the latest
+ *     cold sitting a pass.
+ *   - Source honesty: exact sources (board, MIDI, on-screen keys, taps, screen
+ *     answers, confirmed counts, recorded games, the engine) count. Estimates
+ *     (microphone, camera) count only when confirmed (a second take, the
+ *     verifier, a listener), so an estimate is never the only evidence.
+ *     Self-report, film for a person to review, and imported ratings never
+ *     prove; a metric whose only sources are those is `attest`: it is
+ *     recorded and shown, never machine-proven, and the stage lists it.
+ *   - Kept: a stage with a retention test needs a cold pass at least that many
+ *     days after the proof. Two cold misses in a row after the proof lapse the
+ *     metric: it must be proven again.
+ *
+ * The stage gate (stageGate) holds a stage complete, or skipped by placement,
+ * until every knowledge objective is kept (coverage.gate) and every provable
+ * metric is proven (and kept, where the stage names a retention test). The
+ * same rule decides a skip: placement can only skip a stage by proving it.
+ *
+ * Pure: no database. services/skill-record.js keeps the record.
+ */
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+
+const SKILLS_DIR = path.join(__dirname, '..', 'content', 'skill-progressions');
+const HOUR = 3600 * 1000;
+const DAY = 24 * HOUR;
+const SUBJECTS = ['chess', 'piano', 'basketball'];
+
+function knobs() {
+  const num = (name, fallback) => {
+    const v = Number(process.env[name]);
+    return process.env[name] !== undefined && process.env[name] !== '' && Number.isFinite(v) ? v : fallback;
+  };
+  return {
+    COLD_HOURS: num('SKILL_COLD_HOURS', 20),
+    PROOF_DAYS: num('SKILL_PROOF_DAYS', 2),
+    LAPSE_MISSES: num('SKILL_LAPSE_MISSES', 2),
+    PRIOR: num('SKILL_PRIOR', 0.5),
+    PASS_IF_AT: num('SKILL_PASS_IF_AT', 0.85),
+    LUCK: num('SKILL_LUCK', 0.15),
+    PROVEN_AT: num('SKILL_PROVEN_AT', 0.95),
+    // The battery must stand at exit: a metric whose last cold pass is older
+    // than this needs a fresh cold sitting before the stage completes.
+    STALE_DAYS: num('SKILL_STALE_DAYS', 7),
+    DEFAULT_RETAIN_DAYS: num('SKILL_DEFAULT_RETAIN_DAYS', 0),
+  };
+}
+
+// ── sources ────────────────────────────────────────────────────────────────
+
+/** One source word's class. */
+function sourceClass(word) {
+  const w = String(word || '').toLowerCase().trim();
+  if (!w) return null;
+  if (/count/.test(w)) return 'exact'; // confirmed counts (a parent's count too)
+  if (/^(board|midi|on-screen|tap|screen|items|games|engine)$/.test(w)) return 'exact';
+  if (/verifier/.test(w)) return 'estimate';
+  if (/mic|camera|audio|estimate/.test(w)) return 'estimate';
+  if (/import|external/.test(w)) return 'external';
+  if (/human|teacher|listener|film/.test(w)) return 'human';
+  if (/self|log/.test(w)) return 'self';
+  return 'unknown';
+}
+
+/**
+ * A metric's source string ("midi | mic", "count + camera estimate",
+ * "film + self", "games + import") read as what can prove it.
+ *   provable  some required part is exact and no required part needs a person
+ *             or self-report;
+ *   exact     an exact source exists;
+ *   estimate  an estimate source exists (counts only when confirmed);
+ *   attest    not machine-provable: recorded and listed, never proven here.
+ */
+function readSource(source) {
+  const raw = String(source || '').replace(/\([^)]*\)/g, ' ');
+  // "a + b": both parts take part; within a part "x | y" or "x / y" are
+  // alternatives. An estimate or import part added to an exact one is
+  // supplementary (never the only evidence, never required).
+  const parts = raw.split('+').map((p) => p.split(/[|/]/).map((x) => sourceClass(x)).filter(Boolean)).filter((p) => p.length);
+  const classes = new Set(parts.flat());
+  const partClass = (alts) => (alts.includes('exact') ? 'exact' : alts.includes('estimate') ? 'estimate' : alts.includes('external') ? 'external' : alts.includes('human') ? 'human' : alts.includes('self') ? 'self' : 'unknown');
+  const kinds = parts.map(partClass);
+  const needsPerson = kinds.some((c) => c === 'human' || c === 'self');
+  const exact = kinds.includes('exact');
+  const provable = exact && !needsPerson;
+  return { provable, exact, estimate: classes.has('estimate'), attest: !provable, kinds, raw: String(source || '') };
+}
+
+// ── stages ─────────────────────────────────────────────────────────────────
+
+const cache = new Map();
+
+/** The stages of one skill subject, from its staged progression. */
+function stagesFor(subject) {
+  if (cache.has(subject)) return cache.get(subject);
+  const file = path.join(SKILLS_DIR, `${subject}.json`);
+  const prog = JSON.parse(fs.readFileSync(file, 'utf8'));
+  const stages = prog.stages.map((st, index) => {
+    const retentionText = (st.exit && st.exit.retention) || '';
+    const m = /(\d+)\s*\+?\s*days/.exec(retentionText);
+    const metrics = ((st.exit && st.exit.performance) || []).map((p) => ({
+      id: `${st.id}:${p.metric}`,
+      metric: p.metric,
+      test: p.test || '',
+      threshold: p.threshold || '',
+      source: readSource(p.source),
+      tag: p.tag || '',
+    }));
+    return {
+      subject,
+      index,
+      id: st.id,
+      name: st.name,
+      grades: st.grades || [],
+      objectives: st.objectives || [],
+      knowledge: (st.exit && st.exit.knowledge) || '',
+      metrics,
+      // A stage that names no retention test gets the default one (a cold
+      // pass DEFAULT_RETAIN_DAYS after the proof), as every coverage objective
+      // must be kept after it is proven. 0 turns the default off.
+      retention_days: m ? Number(m[1]) : (knobs().DEFAULT_RETAIN_DAYS || null),
+      retention_default: !m,
+      retention_text: retentionText,
+      session_minutes: (st.practice && st.practice.session_minutes) || null,
+    };
+  });
+  cache.set(subject, stages);
+  return stages;
+}
+
+/**
+ * Machine checks of every stage: every metric has a test, a pass rule and a
+ * source; the stage's grades exist in the app and have knowledge objectives
+ * (coverage.modelFor); a stage with no provable metric is listed (it can only
+ * be attested, so its performance part cannot gate).
+ */
+function validate(subject, { coverage = null } = {}) {
+  const problems = [];
+  const notes = [];
+  let metrics = 0;
+  let provable = 0;
+  let knowledgeObjectives = 0;
+  for (const st of stagesFor(subject)) {
+    if (!st.objectives.length) problems.push(`${st.id}: no objectives`);
+    if (!st.metrics.length) problems.push(`${st.id}: no exit battery`);
+    for (const mt of st.metrics) {
+      metrics += 1;
+      if (!mt.test) problems.push(`${mt.id}: no test`);
+      if (!mt.threshold) problems.push(`${mt.id}: no pass rule`);
+      if (!mt.source.raw) problems.push(`${mt.id}: no source`);
+      if (mt.source.kinds.includes('unknown')) problems.push(`${mt.id}: unknown source "${mt.source.raw}"`);
+      if (mt.source.provable) provable += 1;
+    }
+    if (!st.metrics.some((x) => x.source.provable)) notes.push(`${st.id}: no machine-provable metric (${st.metrics.map((x) => `${x.metric}[${x.source.raw}]`).join(', ')}); its performance part is attested, not gated`);
+    if (coverage) {
+      for (const g of st.grades) {
+        const model = coverage.modelFor(subject, g);
+        if (!model) problems.push(`${st.id}: grade ${g} has no coverage model`);
+        else knowledgeObjectives += model.objectives.length;
+      }
+    }
+  }
+  return { ok: !problems.length, problems, notes, stats: { stages: stagesFor(subject).length, metrics, provable, knowledge_objectives: knowledgeObjectives } };
+}
+
+// ── the record ─────────────────────────────────────────────────────────────
+
+function blankMetric() {
+  return {
+    status: 'unproven', // unproven | proven | retained | lapsed
+    sittings: [],
+    last_practice_at: null,
+    last_sat_at: null,
+    proof_days: [],
+    proven_at: null,
+    retained_at: null,
+    cold_misses_after: 0,
+    lapses: 0,
+    B: knobs().PRIOR,
+  };
+}
+
+function blankRecord(subject) {
+  const rec = { subject, metrics: {} };
+  for (const st of stagesFor(subject)) for (const mt of st.metrics) rec.metrics[mt.id] = blankMetric();
+  return rec;
+}
+
+const dayOf = (t) => Math.floor(t / DAY);
+
+/** Practice on a metric (warm work): only its time matters to coldness. */
+function practise(rec, metricId, at) {
+  const m = rec.metrics[metricId];
+  if (m) m.last_practice_at = at;
+}
+
+/**
+ * Is a sitting at `at` cold? The first sitting of the metric on its day, and
+ * COLD_HOURS or more since it was last practised or sat.
+ */
+function isCold(m, at, k = knobs()) {
+  const last = Math.max(m.last_practice_at === null ? -Infinity : m.last_practice_at, m.last_sat_at === null ? -Infinity : m.last_sat_at);
+  if (m.sittings.some((s) => dayOf(s.at) === dayOf(at))) return false;
+  return at - last >= k.COLD_HOURS * HOUR;
+}
+
+/**
+ * Fold one sitting of a metric's test: {at, pass, source: 'exact'|'estimate'|
+ * 'self'|'human'|'external', confirmed}. Returns the metric's state.
+ */
+function sit(rec, stage, metricId, sitting, k = knobs()) {
+  const mt = stage.metrics.find((x) => x.id === metricId);
+  const m = rec.metrics[metricId];
+  if (!mt || !m) throw new Error(`unknown metric ${metricId}`);
+  const cold = isCold(m, sitting.at, k);
+  const counts = cold && mt.source.provable
+    && (sitting.source === 'exact' || (sitting.source === 'estimate' && sitting.confirmed === true));
+  m.sittings.push({ at: sitting.at, pass: !!sitting.pass, cold, source: sitting.source, confirmed: sitting.confirmed === true, counts });
+  m.last_sat_at = sitting.at;
+  if (!counts) return m;
+  const d = dayOf(sitting.at);
+  // The belief that the learner is at the gate's threshold, from every
+  // counting sitting: a pass is PASS_IF_AT likely at the threshold and LUCK
+  // likely below it (about the staged gates' own simulated error rates). Two
+  // passes from the even prior prove a metric, as the two-day rule says; each
+  // miss in between needs another pass, so retaking until two lucky passes
+  // come cannot prove it (sequential testing).
+  const yes = sitting.pass ? k.PASS_IF_AT : 1 - k.PASS_IF_AT;
+  const no = sitting.pass ? k.LUCK : 1 - k.LUCK;
+  m.B = (m.B * yes) / (m.B * yes + (1 - m.B) * no);
+  if (m.status === 'unproven' || m.status === 'lapsed') {
+    if (sitting.pass) {
+      if (!m.proof_days.some((x) => x.day === d)) m.proof_days.push({ day: d, source: sitting.source });
+      // An estimate counted only with its confirmation (a second take, the
+      // verifier, a listener), so it is never the only evidence.
+      if (m.proof_days.length >= k.PROOF_DAYS && m.B >= k.PROVEN_AT) {
+        m.status = stage.retention_days ? 'proven' : 'retained';
+        m.proven_at = sitting.at;
+        m.retained_at = stage.retention_days ? null : sitting.at;
+        m.cold_misses_after = 0;
+      }
+    }
+    return m;
+  }
+  // Proven or retained: a retention check, or a lapse.
+  if (sitting.pass) {
+    m.cold_misses_after = 0;
+    if (m.status === 'proven' && stage.retention_days && sitting.at - m.proven_at >= stage.retention_days * DAY) {
+      m.status = 'retained';
+      m.retained_at = sitting.at;
+    }
+  } else {
+    m.cold_misses_after += 1;
+    if (m.cold_misses_after >= k.LAPSE_MISSES || m.B < 0.5) {
+      m.B = Math.min(m.B, k.PRIOR);
+      m.status = 'lapsed';
+      m.lapses += 1;
+      m.proof_days = [];
+      m.proven_at = null;
+      m.retained_at = null;
+      m.cold_misses_after = 0;
+    }
+  }
+  return m;
+}
+
+/**
+ * The stage gate. With `now`, a proven metric whose last cold pass is more
+ * than STALE_DAYS old is `stale` and holds the stage until a fresh cold
+ * sitting passes: the battery must stand when the stage is left. `knowledge` is {gradeId: {complete: boolean}} from
+ * coverage.gate for each of the stage's grades (or a function of gradeId);
+ * missing means not complete. Attest-only metrics are listed and never block
+ * or prove (owner decision 6b in ADAPTIVE-COVERAGE.md: whether a person's
+ * sign-off should be required for them).
+ *
+ * @returns {{complete, knowledge_ok, missing: string[], unkept: string[], attest: string[], knowledge_missing: string[]}}
+ */
+function stageGate(rec, stage, knowledge = {}, now = null, k = knobs()) {
+  const missing = [];
+  const unkept = [];
+  const attest = [];
+  const stale = [];
+  for (const mt of stage.metrics) {
+    if (!mt.source.provable) { attest.push(mt.id); continue; }
+    const m = rec.metrics[mt.id];
+    if (!m || m.status === 'unproven' || m.status === 'lapsed') missing.push(mt.id);
+    else if (m.status === 'proven') unkept.push(mt.id);
+    else if (now !== null && now - lastCountingPass(m) > k.STALE_DAYS * DAY) stale.push(mt.id);
+  }
+  const knowledgeMissing = stage.grades.filter((g) => {
+    const v = typeof knowledge === 'function' ? knowledge(g) : knowledge[g];
+    return !(v && v.complete);
+  });
+  const knowledgeOk = !knowledgeMissing.length;
+  return { complete: knowledgeOk && !missing.length && !unkept.length && !stale.length, knowledge_ok: knowledgeOk, missing, unkept, stale, attest, knowledge_missing: knowledgeMissing };
+}
+
+/** When the metric last passed a counting (cold) sitting. */
+function lastCountingPass(m) {
+  for (let j = m.sittings.length - 1; j >= 0; j--) if (m.sittings[j].counts && m.sittings[j].pass) return m.sittings[j].at;
+  return -Infinity;
+}
+
+/**
+ * The proof behind a metric marked proven, re-derived from its sittings: at
+ * least PROOF_DAYS distinct days with a counting cold pass, the last counting
+ * sitting before the proof a pass, and an exact one among them when the
+ * metric has an exact source. The audit runs this on every stage a learner
+ * completed or skipped.
+ */
+function proofHolds(stage, m, metricId, k = knobs()) {
+  const mt = stage.metrics.find((x) => x.id === metricId);
+  if (!mt || !mt.source.provable) return { ok: false, why: 'not machine-provable' };
+  if (m.status !== 'proven' && m.status !== 'retained') return { ok: false, why: `status ${m.status}` };
+  const counting = m.sittings.filter((s) => s.counts && s.at <= m.proven_at);
+  const passDays = new Set(counting.filter((s) => s.pass).map((s) => dayOf(s.at)));
+  if (passDays.size < k.PROOF_DAYS) return { ok: false, why: `cold passes on ${passDays.size} day(s)` };
+  if (!counting.length || !counting[counting.length - 1].pass) return { ok: false, why: 'last counting sitting before the proof was not a pass' };
+  if (counting.some((s) => !(s.source === 'exact' || (s.source === 'estimate' && s.confirmed)))) return { ok: false, why: 'an unconfirmed estimate, self-report, person or import counted' };
+  if (counting.some((s) => !s.cold)) return { ok: false, why: 'a warm sitting counted' };
+  if (stage.retention_days && m.status === 'retained') {
+    const later = m.sittings.filter((s) => s.counts && s.pass && s.at - m.proven_at >= stage.retention_days * DAY);
+    if (!later.length) return { ok: false, why: 'retained without a retention sitting' };
+  }
+  return { ok: true };
+}
+
+module.exports = {
+  SUBJECTS,
+  DAY,
+  HOUR,
+  knobs,
+  sourceClass,
+  readSource,
+  stagesFor,
+  validate,
+  blankRecord,
+  blankMetric,
+  practise,
+  isCold,
+  sit,
+  stageGate,
+  lastCountingPass,
+  proofHolds,
+};
diff --git a/services/skill-record.js b/services/skill-record.js
new file mode 100644
index 0000000..69855b2
--- /dev/null
+++ b/services/skill-record.js
@@ -0,0 +1,308 @@
+/**
+ * The skill record store (staged patch skills-round3/01-skill-record;
+ * SKILL_RECORD=on). Chess, piano and basketball: one row per learner per
+ * exit-battery metric in `skill_records`, holding every sitting of that
+ * metric's stage test and its warm practice sets, folded by the rules in
+ * services/skill-coverage.js (SKILL-CURRICULA.md section 2):
+ *
+ *   - cold or warm: a sitting is cold when it is the metric's first of the
+ *     day and 20+ hours after the metric was last practised or sat;
+ *   - day: proof needs cold passes on two different days;
+ *   - source and confirmation: board, MIDI, on-screen keys, taps, screen
+ *     answers and counts are exact; a microphone or camera result is an
+ *     estimate and counts only when confirmed; a source the metric does not
+ *     list never counts;
+ *   - a Bayes belief over the counting sittings, so retaking until two lucky
+ *     passes come cannot prove a metric.
+ *
+ * Rows hold times as epoch milliseconds (the rule functions do arithmetic on
+ * them) and each sitting also carries its ISO time and UTC day. Nothing here
+ * decides a stage on its own: services that read the record (the stage
+ * checks, the stage gate, the practice plan: patches 02-04) do.
+ *
+ * Camera and microphone stay on the learner's device: only a sitting's result
+ * (pass or fail, a score, a count) and, for piano, the played note events
+ * reach this store, never a picture, a clip or sound.
+ */
+'use strict';
+
+const db = require('../config/db');
+const sc = require('./skill-coverage');
+
+const COLLECTION = 'skill_records';
+const KINDS = ['stage_test', 'retention_test', 'stands_test', 'placement', 'check'];
+
+function enabled() {
+  return String(process.env.SKILL_RECORD || 'off').toLowerCase() === 'on';
+}
+
+function isSkillTrack(trackId) {
+  return sc.SUBJECTS.includes(trackId);
+}
+
+/** The stage a grade belongs to, or null. */
+function stageFor(subject, gradeId) {
+  if (!isSkillTrack(subject)) return null;
+  return sc.stagesFor(subject).find((st) => st.grades.includes(gradeId)) || null;
+}
+
+/** A metric and its stage, by id ("CH1:kqk_playout"). */
+function metricDef(subject, metricId) {
+  if (!isSkillTrack(subject)) return null;
+  for (const st of sc.stagesFor(subject)) {
+    const mt = st.metrics.find((x) => x.id === metricId);
+    if (mt) return { stage: st, metric: mt };
+  }
+  return null;
+}
+
+// ── sources ────────────────────────────────────────────────────────────────
+
+const WORDS = ['board', 'midi', 'mic', 'on-screen', 'tap', 'screen', 'items', 'games', 'engine', 'count', 'camera', 'audio', 'verifier', 'self', 'log', 'film', 'human', 'import'];
+
+/** The source words a metric lists, parenthesised options included ("count (camera estimate optional)"). */
+function listedWords(mt) {
+  const raw = String((mt.source && mt.source.raw) || '').toLowerCase();
+  return WORDS.filter((w) => new RegExp(`(^|[^a-z-])${w.replace('-', '\\-')}([^a-z-]|$)`).test(raw)
+    || (w === 'mic' && /mic-verifier/.test(raw)) || (w === 'on-screen' && /on-screen/.test(raw)));
+}
+
+/**
+ * How a sitting's source counts for this metric: {word, cls, accepted, why}.
+ * The class is skill-coverage's (exact | estimate | self | human | external);
+ * a word the metric does not list is recorded but never counts.
+ */
+function readSitSource(mt, word) {
+  const w = String(word || '').toLowerCase().trim();
+  const cls = sc.sourceClass(w === 'on-screen' || w === 'screen-keys' ? 'on-screen' : w) || 'unknown';
+  const listed = listedWords(mt);
+  const accepted = !!w && listed.includes(w) && (cls === 'exact' || cls === 'estimate') && mt.source.provable;
+  let why = null;
+  if (!mt.source.provable) why = 'this metric is attested only: a machine never proves it';
+  else if (!listed.includes(w)) why = `"${w || 'unknown'}" is not a source this metric lists (${mt.source.raw})`;
+  else if (!(cls === 'exact' || cls === 'estimate')) why = `${w} never proves a metric`;
+  return { word: w, cls, accepted, why };
+}
+
+// ── rows ───────────────────────────────────────────────────────────────────
+
+function blankRow(userId, subject, stage, mt) {
+  return {
+    user_id: userId,
+    subject,
+    stage_id: stage.id,
+    metric_id: mt.id,
+    metric: mt.metric,
+    ...sc.blankMetric(),
+    warm: [],
+    sets: 0,
+    sets_at_proof: null,
+    open: null,
+  };
+}
+
+function rowFor(userId, subject, metricId) {
+  return db.findOne(COLLECTION, (r) => r.user_id === userId && r.subject === subject && r.metric_id === metricId);
+}
+
+function ensureRow(userId, subject, metricId) {
+  const def = metricDef(subject, metricId);
+  if (!def) return null;
+  return rowFor(userId, subject, metricId) || db.insert(COLLECTION, blankRow(userId, subject, def.stage, def.metric));
+}
+
+/** Save a row mutated in place (the rule functions write to it directly). */
+function save(row) {
+  const { id, ...rest } = row;
+  return db.update(COLLECTION, id, rest);
+}
+
+/**
+ * The learner's record for one subject, in the shape skill-coverage reads:
+ * {subject, metrics: {metricId: row}}. Metrics never sat are blank (and not
+ * stored).
+ */
+function recordFor(userId, subject) {
+  const rec = { subject, metrics: {} };
+  for (const st of sc.stagesFor(subject)) {
+    for (const mt of st.metrics) rec.metrics[mt.id] = blankRow(userId, subject, st, mt);
+  }
+  for (const row of db.find(COLLECTION, (r) => r.user_id === userId && r.subject === subject)) {
+    if (rec.metrics[row.metric_id]) rec.metrics[row.metric_id] = row;
+  }
+  return rec;
+}
+
+const dayIso = (t) => new Date(t).toISOString().slice(0, 10);
+
+/**
+ * Record one sitting of a metric's stage test and fold it into the proof.
+ *
+ * @param {number} userId
+ * @param {object} s {subject, metricId, pass, source (word), confirmed, kind, score, n, detail, at}
+ * @returns {{row, sitting, counted: boolean, why: string|null, proved: boolean}|{error}}
+ */
+function sit(userId, s) {
+  const def = metricDef(s.subject, s.metricId);
+  if (!def) return { error: 'No such skill check.' };
+  const { stage, metric: mt } = def;
+  const at = Number.isFinite(s.at) ? s.at : Date.now();
+  const src = readSitSource(mt, s.source);
+  const row = ensureRow(userId, s.subject, s.metricId);
+  const before = row.status;
+  // A source the metric does not list is recorded with a class that cannot
+  // count; skill-coverage.sit then marks it cold or warm as usual.
+  const cls = src.accepted ? src.cls : 'unlisted';
+  sc.sit({ metrics: { [mt.id]: row } }, stage, mt.id, { at, pass: !!s.pass, source: cls, confirmed: s.confirmed === true });
+  const sitting = row.sittings[row.sittings.length - 1];
+  Object.assign(sitting, {
+    at_iso: new Date(at).toISOString(),
+    day: dayIso(at),
+    kind: KINDS.includes(s.kind) ? s.kind : 'stage_test',
+    source_word: src.word,
+    score: s.score === undefined ? null : s.score,
+    n: s.n === undefined ? null : s.n,
+    detail: s.detail || null,
+  });
+  if (!sitting.counts) {
+    sitting.why_not = src.why
+      || (!sitting.cold ? 'warm: not the first sitting of the day, or less than 20 hours after practising it' : null)
+      || (src.cls === 'estimate' && s.confirmed !== true ? 'an estimate counts only when it is confirmed' : null);
+  }
+  if ((row.status === 'unproven' || row.status === 'lapsed') && before !== row.status) row.sets_at_proof = null;
+  save(row);
+  const proved = (before === 'unproven' || before === 'lapsed') && (row.status === 'proven' || row.status === 'retained');
+  return { row, sitting, counted: !!sitting.counts, why: sitting.why_not || null, proved };
+}
+
+/**
+ * One warm practice set on a metric: its time (it makes the next sitting warm
+ * for 20 hours) and whether it was at the target. Counted for the practice
+ * plan's over-learning dose (patch 04).
+ */
+function practise(userId, { subject, metricId, atTarget, at = Date.now() }) {
+  const row = ensureRow(userId, subject, metricId);
+  if (!row) return null;
+  const proven = row.status === 'proven' || row.status === 'retained';
+  row.last_practice_at = at;
+  row.sets = (row.sets || 0) + 1;
+  if (!proven) row.sets_at_proof = null;
+  else if (row.sets_at_proof === null || row.sets_at_proof === undefined) row.sets_at_proof = row.sets - 1;
+  row.warm = [...(row.warm || []), { at, atTarget: !!atTarget, day: dayIso(at) }].slice(-12);
+  save(row);
+  return row;
+}
+
+/** When the next sitting of a metric would be cold (ms), given `now`. */
+function coldAt(row, now = Date.now(), k = sc.knobs()) {
+  if (sc.isCold(row, now, k)) return now;
+  const last = Math.max(row.last_practice_at || 0, row.last_sat_at || 0);
+  const byHours = last + k.COLD_HOURS * sc.HOUR;
+  const tomorrow = (Math.floor(now / sc.DAY) + 1) * sc.DAY;
+  const satToday = (row.sittings || []).some((s) => Math.floor(s.at / sc.DAY) === Math.floor(now / sc.DAY));
+  return Math.max(byHours, satToday ? tomorrow : 0, now);
+}
+
+/**
+ * The knowledge side of a stage: each of its grades' coverage gate
+ * (services/coverage.js) for this learner. A grade already graduated counts as
+ * complete; a grade not enrolled does not.
+ */
+function knowledgeFor(userId, subject) {
+  // eslint-disable-next-line global-require
+  const coverage = require('./coverage');
+  return (gradeId) => {
+    const e = db.findOne('enrollments', (x) => x.user_id === userId && x.track_id === subject && x.grade_id === gradeId);
+    if (!e) return { complete: false, why: 'not enrolled' };
+    if (e.status === 'graduated') return { complete: true, why: 'graduated' };
+    try {
+      const cover = coverage.forEnrollment(userId, e);
+      if (!cover) return { complete: true, why: 'no objective record for this grade' };
+      return { complete: !!cover.gate.complete, why: `${cover.gate.total - cover.gate.blocking.length} of ${cover.gate.total} objectives proven and kept`, total: cover.gate.total, blocking: cover.gate.blocking.length };
+    } catch (err) {
+      return { complete: false, why: `coverage unavailable: ${err.message}` };
+    }
+  };
+}
+
+/**
+ * The learner's current stage on an enrollment, as the pages show it: each
+ * metric's status, its sittings and when it can next be sat cold, and the
+ * stage gate (skill-coverage.stageGate) with the knowledge side.
+ */
+function stageView(userId, enrollment, now = Date.now()) {
+  const stage = stageFor(enrollment.track_id, enrollment.grade_id);
+  if (!stage) return null;
+  const k = sc.knobs();
+  const rec = recordFor(userId, enrollment.track_id);
+  const knowledge = knowledgeFor(userId, enrollment.track_id);
+  const gate = sc.stageGate(rec, stage, (g) => knowledge(g), now, k);
+  const metrics = stage.metrics.map((mt) => {
+    const row = rec.metrics[mt.id];
+    const last = row.sittings.length ? row.sittings[row.sittings.length - 1] : null;
+    const lastPass = sc.lastCountingPass(row);
+    const retentionDue = row.status === 'proven' && stage.retention_days ? row.proven_at + stage.retention_days * sc.DAY : null;
+    const stale = row.status === 'retained' && now - lastPass > k.STALE_DAYS * sc.DAY;
+    return {
+      id: mt.id,
+      metric: mt.metric,
+      test: mt.test,
+      threshold: mt.threshold,
+      source: mt.source.raw,
+      provable: mt.source.provable,
+      estimate: mt.source.estimate,
+      status: mt.source.provable ? row.status : 'attest',
+      belief: Number((row.B || 0).toFixed(3)),
+      proof_days: (row.proof_days || []).length,
+      proven_at: row.proven_at ? new Date(row.proven_at).toISOString() : null,
+      retained_at: row.retained_at ? new Date(row.retained_at).toISOString() : null,
+      retention_due_at: retentionDue ? new Date(retentionDue).toISOString() : null,
+      stale,
+      sittings: row.sittings.length,
+      counting: row.sittings.filter((s) => s.counts).length,
+      last: last ? { at: last.at_iso || new Date(last.at).toISOString(), pass: last.pass, counts: last.counts, cold: last.cold, source: last.source_word || last.source, confirmed: last.confirmed, why_not: last.why_not || null, score: last.score === undefined ? null : last.score } : null,
+      cold_now: sc.isCold(row, now, k),
+      cold_at: new Date(coldAt(row, now, k)).toISOString(),
+      warm_sets: (row.warm || []).length,
+    };
+  });
+  const grades = stage.grades.map((g) => ({ id: g, ...knowledge(g) }));
+  return {
+    subject: enrollment.track_id,
+    stage: { id: stage.id, name: stage.name, grades: stage.grades, retention_days: stage.retention_days, retention_text: stage.retention_text, session_minutes: stage.session_minutes, knowledge: stage.knowledge },
+    metrics,
+    knowledge: grades,
+    gate: { ...gate, provable: stage.metrics.filter((m) => m.source.provable).length, proven: metrics.filter((m) => m.provable && (m.status === 'proven' || m.status === 'retained')).length },
+  };
+}
+
+/** Re-derive every proof on a stage from its sittings (skill-coverage.proofHolds). */
+function auditStage(userId, subject, stageId) {
+  const stage = sc.stagesFor(subject).find((s) => s.id === stageId);
+  if (!stage) return null;
+  const rec = recordFor(userId, subject);
+  return stage.metrics.filter((m) => m.source.provable).map((mt) => {
+    const row = rec.metrics[mt.id];
+    const proven = row.status === 'proven' || row.status === 'retained';
+    return { id: mt.id, status: row.status, holds: proven ? sc.proofHolds(stage, row, mt.id) : null };
+  });
+}
+
+module.exports = {
+  COLLECTION,
+  enabled,
+  isSkillTrack,
+  stageFor,
+  metricDef,
+  listedWords,
+  readSitSource,
+  rowFor,
+  ensureRow,
+  recordFor,
+  sit,
+  practise,
+  coldAt,
+  knowledgeFor,
+  stageView,
+  auditStage,
+};
diff --git a/routes/skills.js b/routes/skills.js
new file mode 100644
index 0000000..6ce12b6
--- /dev/null
+++ b/routes/skills.js
@@ -0,0 +1,85 @@
+/**
+ * Chess, piano and basketball: the skill record (services/skill-record.js;
+ * staged patch skills-round3/01-skill-record). Off unless SKILL_RECORD=on:
+ * every route under /api/skills then answers 404, the same as before.
+ *
+ *   GET /api/skills/record/:enrollmentId   the current stage: each metric's status and sittings, the gate
+ *   GET /api/skills/path/:enrollmentId     the rows the path shows for this stage (from the parts below)
+ *
+ * The other staged parts mount here when their patch is applied, each behind
+ * its own flag: routes/skill-checks.js (02, SKILL_STAGE_TESTS), routes/skill-gate.js
+ * (03, SKILL_STAGE_GATE) and routes/skill-dose.js (04, SKILL_DOSE). Each exports
+ * its router and a `pathNode(userId, enrollment, view)` for the path.
+ */
+const express = require('express');
+const db = require('../config/db');
+const curriculum = require('../config/curriculum');
+const record = require('../services/skill-record');
+const { requireAuth } = require('../middleware/auth');
+
+const router = express.Router();
+
+/** A staged part, when its patch has been applied; null when it has not. */
+function part(name) {
+  try {
+    // eslint-disable-next-line global-require, import/no-dynamic-require
+    return require(`./${name}`);
+  } catch (err) {
+    if (err && err.code === 'MODULE_NOT_FOUND' && String(err.message).includes(name)) return null;
+    throw err;
+  }
+}
+const PARTS = ['skill-checks', 'skill-gate', 'skill-dose'].map((name) => ({ name, mod: part(name) })).filter((p) => p.mod);
+
+router.use('/skills', (req, res, next) => {
+  if (!record.enabled()) return res.status(404).json({ error: 'No such endpoint.' });
+  next();
+});
+
+/** The signed-in learner's own skill-subject enrollment, or a reason it is not. */
+function skillEnrollment(req) {
+  const enrollment = db.byId('enrollments', req.params.enrollmentId);
+  if (!enrollment || enrollment.user_id !== req.user.id) return { status: 404, error: 'Enrollment not found.' };
+  if (!record.isSkillTrack(enrollment.track_id)) return { status: 404, error: 'This subject has no skill record.' };
+  if (!record.stageFor(enrollment.track_id, enrollment.grade_id)) return { status: 404, error: 'This grade is in no skill stage.' };
+  return { enrollment };
+}
+
+function heading(enrollment) {
+  const grade = curriculum.getGrade(enrollment.track_id, enrollment.grade_id);
+  const track = curriculum.getTrack(enrollment.track_id);
+  return {
+    enrollment: { id: enrollment.id, status: enrollment.status, current_level: enrollment.current_level, path_length: grade ? grade.pathLength : null },
+    track: track ? { id: track.id, name: track.name } : { id: enrollment.track_id, name: enrollment.track_id },
+    grade: grade ? { id: grade.id, name: grade.name } : { id: enrollment.grade_id, name: enrollment.grade_id },
+  };
+}
+
+router.get('/skills/record/:enrollmentId', requireAuth, (req, res) => {
+  const { enrollment, status, error } = skillEnrollment(req);
+  if (!enrollment) return res.status(status).json({ error });
+  res.json({ ...heading(enrollment), record: record.stageView(req.user.id, enrollment) });
+});
+
+router.get('/skills/path/:enrollmentId', requireAuth, (req, res) => {
+  const { enrollment } = skillEnrollment(req);
+  if (!enrollment) return res.json({ nodes: [] });
+  const view = record.stageView(req.user.id, enrollment);
+  const nodes = [];
+  for (const p of PARTS) {
+    if (typeof p.mod.pathNode !== 'function') continue;
+    try {
+      const node = p.mod.pathNode(req.user.id, enrollment, view);
+      if (node) nodes.push(...[].concat(node));
+    } catch (err) {
+      console.error(`[skills] ${p.name} path row failed: ${err.message}`);
+    }
+  }
+  res.json({ stage: view ? { id: view.stage.id, name: view.stage.name } : null, nodes });
+});
+
+for (const p of PARTS) if (p.mod.router || typeof p.mod === 'function') router.use(p.mod.router || p.mod);
+
+module.exports = router;
+module.exports.heading = heading;
+module.exports.skillEnrollment = skillEnrollment;
diff --git a/public/js/skill-kit.js b/public/js/skill-kit.js
