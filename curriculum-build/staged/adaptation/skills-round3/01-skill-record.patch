@@ -0,0 +1,275 @@
+/* The measuring kit for chess, piano and basketball checks (staged skills
+ * round 3, patch 01): the runners the stage check page (patch 02) and the
+ * practice page (patch 04) share.
+ *
+ *   SkillKit.items(host, { items, subject, feedback, onAnswer, onDone })
+ *       one question at a time: choices, typed answers, a move on the board,
+ *       a key found on the piano, an echo or a chord heard and answered.
+ *   SkillKit.takes(host, { parts, onTake(part, played, origin), onDone, practice })
+ *       piano: a count-in, then the learner plays; the notes (key numbers and
+ *       times only) go to the server, which scores them with piano-core.
+ *   SkillKit.count(host, { fields, hands, cameraOk, onSubmit })
+ *       basketball: makes and attempts typed in, or the camera tracker's count
+ *       confirmed by the learner.
+ *
+ * Camera and microphone stay on this device. The microphone is heard only
+ * through the piano engine (PolymathPianoIO), which turns sound into note
+ * events here; nothing records or sends sound or pictures. The only network
+ * calls are the callbacks the page passes in, which post answers, note events
+ * and counts to /api/skills.
+ */
+(function (global) {
+  const esc = (s) => (global.App ? global.App.escapeHtml(s) : String(s == null ? '' : s));
+  const IO = () => global.PolymathPianoIO || null;
+  const now = () => (global.performance && performance.now ? performance.now() : Date.now());
+
+  // ── one input for the piano: MIDI when there is a keyboard, else the on-screen keys; the microphone on request ──
+  function pianoInput(host, { onNote, from = 48, to = 84, allowMic = true }) {
+    const io = IO();
+    const wrap = document.createElement('div');
+    wrap.className = 'skill-input';
+    wrap.innerHTML = `
+      <div class="skill-input-row">
+        <span class="tiny muted" data-src>On-screen keys</span>
+        ${io && io.midi.supported() ? '<button class="btn btn-sm" type="button" data-midi>Use a MIDI keyboard</button>' : ''}
+        ${allowMic && io && io.mic.supported() ? '<button class="btn btn-sm" type="button" data-mic>Use the microphone</button>' : ''}
+      </div>
+      <div class="skill-keys"></div>`;
+    host.appendChild(wrap);
+    let stopMidi = null;
+    let stopMic = null;
+    const label = wrap.querySelector('[data-src]');
+    const kb = io ? io.keyboard(wrap.querySelector('.skill-keys'), { from, to, onPress: (e) => onNote({ ...e, source: 'screen' }) }) : null;
+    const midiBtn = wrap.querySelector('[data-midi]');
+    if (midiBtn) midiBtn.addEventListener('click', async () => {
+      try {
+        const c = await io.midi.connect((e) => onNote(e));
+        stopMidi = c.stop;
+        label.textContent = c.devices && c.devices.length ? `MIDI: ${c.devices.join(', ')}` : 'MIDI: waiting for a keyboard';
+        midiBtn.disabled = true;
+      } catch (err) { global.App.toast(err.message, 'error'); }
+    });
+    const micBtn = wrap.querySelector('[data-mic]');
+    if (micBtn) micBtn.addEventListener('click', async () => {
+      try {
+        const m = await io.mic.start((e) => onNote({ ...e, source: 'mic' }), {});
+        stopMic = m.stop;
+        label.textContent = 'Microphone: heard on this device only (an estimate; a second take confirms it)';
+        micBtn.disabled = true;
+      } catch (err) { global.App.toast(err.message, 'error'); }
+    });
+    return {
+      keyboard: kb,
+      stop() { try { if (stopMidi) stopMidi(); } catch (e) { /* gone */ } try { if (stopMic) stopMic(); } catch (e) { /* gone */ } if (kb) kb.destroy(); },
+    };
+  }
+
+  // ── items ─────────────────────────────────────────────────────────────────
+  function items(host, o) {
+    const list = o.items;
+    let index = (o.answered || []).findIndex((x) => !x);
+    if (index < 0) index = o.answered && o.answered.length ? list.length : 0;
+    let input = null;
+    let board = null;
+
+    function cleanup() {
+      if (input) { input.stop(); input = null; }
+      board = null;
+    }
+
+    async function submit(answer, source) {
+      host.querySelectorAll('button, input').forEach((b) => { b.disabled = true; });
+      let res;
+      try { res = await o.onAnswer(index, answer, source); } catch (err) {
+        global.App.toast(err.message, 'error');
+        host.querySelectorAll('button, input').forEach((b) => { b.disabled = false; });
+        return;
+      }
+      cleanup();
+      if (o.feedback && res) {
+        const v = host.querySelector('[data-verdict]');
+        v.innerHTML = `<p class="skill-verdict ${res.correct ? 'is-right' : 'is-wrong'}">${global.mark(res.correct ? 'tick' : 'cross')}<span>${res.correct ? 'Right.' : 'Not this time.'}${!res.correct && res.answer ? ` The answer: <b>${esc(res.answer)}</b>.` : ''}</span></p>
+          <button class="btn btn-primary" type="button" data-next>${index + 1 < list.length ? 'Next' : 'Finish the set'}</button>`;
+        v.querySelector('[data-next]').addEventListener('click', () => { index += 1; show(); });
+        v.querySelector('[data-next]').focus();
+      } else { index += 1; show(); }
+    }
+
+    function show() {
+      if (index >= list.length) { host.innerHTML = ''; o.onDone(); return; }
+      const it = list[index];
+      host.innerHTML = `
+        <div class="skill-q">
+          <p class="skill-q-count"><span class="num">${index + 1}</span> / <span class="num">${list.length}</span></p>
+          <p class="skill-stem">${esc(it.prompt).replace(/\n/g, '<br>')}</p>
+          <div data-body></div>
+          <div data-verdict aria-live="polite"></div>
+        </div>`;
+      const body = host.querySelector('[data-body]');
+      if (it.kind === 'choice' || it.kind === 'chord_ear') {
+        if (it.kind === 'chord_ear') {
+          body.insertAdjacentHTML('beforeend', '<p><button class="btn" type="button" data-play>Play the chord</button></p>');
+          body.querySelector('[data-play]').addEventListener('click', () => { const io = IO(); if (io) it.notes.forEach((m) => io.synth.play(m, 1200)); });
+        }
+        if (it.fen && global.PolymathBoard) { const b = document.createElement('div'); b.className = 'skill-board'; body.appendChild(b); global.PolymathBoard.create(b, { fen: it.fen, interactive: false }); }
+        const row = document.createElement('div');
+        row.className = 'skill-choices';
+        row.innerHTML = it.choices.map((c) => `<button class="btn choice" type="button" data-c="${esc(c)}">${esc(c)}</button>`).join('');
+        body.appendChild(row);
+        row.querySelectorAll('[data-c]').forEach((b) => b.addEventListener('click', () => submit(b.getAttribute('data-c'), it.kind === 'chord_ear' ? 'tap' : null)));
+      } else if (it.kind === 'move' || it.kind === 'squares' || it.kind === 'text') {
+        if (it.fen && global.PolymathBoard) {
+          const b = document.createElement('div');
+          b.className = 'skill-board';
+          body.appendChild(b);
+          board = global.PolymathBoard.create(b, { fen: it.fen, interactive: it.kind === 'move', onMove: (m, san) => { field.value = san; } });
+        }
+        const form = document.createElement('form');
+        form.className = 'skill-answer';
+        form.innerHTML = `<label class="visually-hidden" for="skill-a">Your answer</label>
+          <input id="skill-a" class="input" autocomplete="off" spellcheck="false" placeholder="${it.kind === 'squares' ? 'e.g. c4 d5 e6' : it.kind === 'move' ? 'Move, e.g. Qh7#' : 'Your answer'}">
+          <button class="btn btn-primary" type="submit">Answer</button>
+          ${it.allow_no_mate ? '<button class="btn" type="button" data-nomate>No mate</button>' : ''}`;
+        body.appendChild(form);
+        const field = form.querySelector('input');
+        form.addEventListener('submit', (e) => { e.preventDefault(); if (field.value.trim()) submit(field.value.trim(), 'board'); });
+        const nm = form.querySelector('[data-nomate]');
+        if (nm) nm.addEventListener('click', () => submit('no mate', 'board'));
+        if (!board) field.focus();
+      } else if (it.kind === 'key') {
+        input = pianoInput(body, { onNote: (e) => { if (!host.dataset.busy) { host.dataset.busy = '1'; submit({ midi: e.midi }, e.source).finally(() => { delete host.dataset.busy; }); } } });
+      } else if (it.kind === 'echo') {
+        const tries = [];
+        let current = [];
+        body.insertAdjacentHTML('beforeend', `<p class="row-wrap"><button class="btn" type="button" data-play>Play it</button>
+          <span class="tiny muted" data-heard>Play back <span class="num">${it.notes.length}</span> notes${it.tries > 1 ? `; <span class="num">${it.tries}</span> tries` : ''}.</span></p>`);
+        body.querySelector('[data-play]').addEventListener('click', () => { const io = IO(); if (io) io.synth.sequence(it.notes.map((m, i) => ({ midi: m, beat: i })), 90); });
+        const heard = body.querySelector('[data-heard]');
+        let source = 'screen';
+        input = pianoInput(body, { onNote: (e) => {
+          source = e.source === 'mic' ? 'mic' : source === 'mic' ? 'mic' : e.source;
+          current.push(e.midi);
+          heard.textContent = `Heard ${current.length} of ${it.notes.length}.`;
+          if (current.length === it.notes.length) {
+            tries.push(current);
+            current = [];
+            if (tries.length >= (it.tries || 1)) submit({ tries }, source);
+            else heard.textContent = `Try ${tries.length + 1} of ${it.tries}: play it again if it was not right, or finish.`;
+          }
+        } });
+        if ((it.tries || 1) > 1) {
+          body.insertAdjacentHTML('beforeend', '<p><button class="btn btn-sm" type="button" data-done>That one was right: answer</button></p>');
+          body.querySelector('[data-done]').addEventListener('click', () => { if (tries.length) submit({ tries }, source); });
+        }
+      }
+    }
+    show();
+    return { stop: cleanup };
+  }
+
+  // ── piano takes ───────────────────────────────────────────────────────────
+  function takes(host, o) {
+    let part = 0;
+    let input = null;
+    function show() {
+      if (input) { input.stop(); input = null; }
+      if (part >= o.parts.length) { host.innerHTML = ''; o.onDone(); return; }
+      const p = o.parts[part];
+      const names = p.chords ? p.chords.join('  ') : p.any_key ? 'Any key, on the click' : (p.names || []).join(' ');
+      host.innerHTML = `
+        <div class="skill-q">
+          <p class="skill-q-count">Part <span class="num">${part + 1}</span> / <span class="num">${o.parts.length}</span></p>
+          <p class="skill-stem">${esc(p.label)}</p>
+          <p class="skill-notes num">${esc(names)}</p>
+          <p class="tiny muted">At <span class="num">${p.tempo}</span> beats a minute. Press Start: <span class="num">${p.count_in || 4}</span> clicks count you in, then play. Press Done when you finish.</p>
+          <div data-input></div>
+          <div class="path-actions"><button class="btn btn-primary" type="button" data-go>Start</button><span class="tiny muted" data-heard></span></div>
+          <div data-verdict aria-live="polite"></div>
+        </div>`;
+      let played = [];
+      let origin = null;
+      let recording = false;
+      input = pianoInput(host.querySelector('[data-input]'), { onNote: (e) => { if (!recording) return; played.push({ midi: e.midi, time: e.time, velocity: e.velocity || null, source: e.source === 'screen' && p.any_key ? 'tap' : e.source, confidence: e.confidence || 1 }); heard.textContent = `${played.length} note${played.length === 1 ? '' : 's'}`; } });
+      const go = host.querySelector('[data-go]');
+      const heard = host.querySelector('[data-heard]');
+      go.addEventListener('click', async () => {
+        if (!recording) {
+          go.disabled = true;
+          const io = IO();
+          const beat = 60000 / p.tempo;
+          for (let i = 0; i < (p.count_in || 4); i++) { if (io) io.synth.click(i === 0); heard.textContent = `${(p.count_in || 4) - i}`; await new Promise((r) => setTimeout(r, beat)); }
+          if (p.any_key && io) {
+            // The click carries on under the taps, one per beat, for as long as the target lasts.
+            const n = (p.target || []).length;
+            for (let i = 0; i < n; i++) setTimeout(() => io.synth.click(false), i * beat);
+          }
+          played = [];
+          origin = now();
+          recording = true;
+          heard.textContent = 'Playing';
+          go.textContent = 'Done';
+          go.disabled = false;
+          return;
+        }
+        recording = false;
+        go.disabled = true;
+        if (!played.length) { heard.textContent = 'No notes heard. Start again.'; go.textContent = 'Start'; go.disabled = false; return; }
+        let res;
+        try { res = await o.onTake(part, played, origin); } catch (err) { global.App.toast(err.message, 'error'); go.textContent = 'Start'; go.disabled = false; return; }
+        const v = host.querySelector('[data-verdict]');
+        const facts = [
+          res.notes != null ? `notes <b class="num">${Math.round(res.notes * 100)}%</b>` : '',
+          res.on_beat != null ? `on the beat <b class="num">${Math.round(res.on_beat * 100)}%</b>` : '',
+          res.cv != null ? `evenness CV <b class="num">${res.cv}</b>` : '',
+          res.stops ? `<b class="num">${res.stops}</b> stop${res.stops === 1 ? '' : 's'}` : '',
+          res.chords != null ? `chords <b class="num">${res.chords_right}/${res.chords}</b>` : '',
+        ].filter(Boolean).join(', ');
+        const needSecond = res.source === 'mic' && !o.practice && (res.takes || 1) < 2;
+        v.innerHTML = `<p class="skill-verdict ${res.pass ? 'is-right' : 'is-wrong'}">${global.mark(res.pass ? 'tick' : 'cross')}<span>${res.pass ? 'At the bar.' : 'Below the bar.'} ${facts}.</span></p>
+          ${res.source === 'mic' ? `<p class="tiny muted">Heard by the microphone: an estimate.${needSecond ? ' Play it once more to confirm it.' : ''}</p>` : ''}
+          <div class="row-wrap">${needSecond ? '<button class="btn" type="button" data-again>Play it again to confirm</button>' : ''}<button class="btn btn-primary" type="button" data-next>${part + 1 < o.parts.length ? 'Next part' : o.practice ? 'Finish the set' : 'Finish the check'}</button></div>`;
+        const again = v.querySelector('[data-again]');
+        if (again) again.addEventListener('click', () => show());
+        v.querySelector('[data-next]').addEventListener('click', () => { part += 1; show(); });
+      });
+    }
+    show();
+    return { stop() { if (input) input.stop(); } };
+  }
+
+  // ── basketball counts ─────────────────────────────────────────────────────
+  function count(host, o) {
+    const fieldsHtml = (prefix, title) => `
+      <fieldset class="skill-count-set">
+        ${title ? `<legend>${esc(title)}</legend>` : ''}
+        ${o.fields.map((f) => `<label class="skill-count"><span>${esc(f.label)}</span><input class="input num" type="number" inputmode="numeric" min="${f.min}" max="${f.max}" name="${prefix}${f.name}" required></label>`).join('')}
+      </fieldset>`;
+    host.innerHTML = `
+      <form class="skill-count-form">
+        ${o.hands ? fieldsHtml('left.', 'Left hand') + fieldsHtml('right.', 'Right hand') : fieldsHtml('', '')}
+        ${o.cameraOk ? `
+          <fieldset class="skill-count-set">
+            <legend>Who counted</legend>
+            <label class="skill-radio"><input type="radio" name="source" value="count" checked> I (or a grown-up) counted</label>
+            <label class="skill-radio"><input type="radio" name="source" value="camera"> The camera tracker counted (it stays on this device)</label>
+            <label class="skill-radio" data-confirm hidden><input type="checkbox" name="confirmed"> I watched and the camera's count is right</label>
+          </fieldset>` : ''}
+        <div class="path-actions"><button class="btn btn-primary" type="submit">${esc(o.submitLabel || 'Record it')}</button></div>
+      </form>`;
+    const form = host.querySelector('form');
+    const confirmRow = form.querySelector('[data-confirm]');
+    form.querySelectorAll('input[name=source]').forEach((r) => r.addEventListener('change', () => { if (confirmRow) confirmRow.hidden = form.source.value !== 'camera'; }));
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const body = {};
+      form.querySelectorAll('input[type=number]').forEach((inp) => {
+        const [a, b] = inp.name.split('.');
+        if (b) { body[a] = body[a] || {}; body[a][b] = Number(inp.value); } else body[a] = Number(inp.value);
+      });
+      if (o.cameraOk) { body.source = form.source.value; body.confirmed = !!(form.confirmed && form.confirmed.checked); }
+      o.onSubmit(body, form);
+    });
+  }
+
+  global.SkillKit = { items, takes, count, pianoInput };
+})(typeof window !== 'undefined' ? window : globalThis);
diff --git a/public/css/skills.css b/public/css/skills.css
new file mode 100644
index 0000000..673e80f
--- /dev/null
+++ b/public/css/skills.css
@@ -0,0 +1,66 @@
+/* Chess, piano and basketball: the stage rows on the path, the stage check,
+   what is left in a stage, and today's practice (staged skills round 3).
+   Quiet like the rest: sections split by space and a hairline, colour only
+   for the subject and for right and wrong. */
+
+/* The path: this stage's rows, a level row with a word on the rail. */
+.skill-stage { margin-bottom: var(--s-2); }
+.node.node-skill .badge { font-family: var(--font); font-size: 0.75rem; font-weight: 700; color: var(--subj); border-right: 3px solid var(--subj); padding-right: 12px; }
+.node.node-skill.node-done .badge { border-right-color: var(--line-strong); }
+.node.node-skill .skill-detail { display: block; line-height: 1.45; color: var(--ink-2); font-size: var(--t-meta); max-width: 70ch; }
+
+/* The pages. */
+.skill-now { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: var(--s-6) var(--s-10); align-items: start; margin-top: var(--s-6); }
+.skill-lede { font-size: 1.125rem; line-height: 1.5; max-width: 60ch; margin: 0 0 var(--s-3); }
+.skill-lede .mark { width: 22px; height: 22px; vertical-align: -4px; margin-right: 6px; }
+.skill-note { max-width: 64ch; margin: 0 0 var(--s-3); }
+.skill-section { margin-top: var(--s-8); max-width: 820px; }
+.skill-list { list-style: none; margin: 0; padding: 0; }
+.skill-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: start; gap: var(--s-2) var(--s-4); padding: 14px 0; border-top: 1px solid var(--line); }
+.skill-row.is-due .skill-title { color: var(--ink); }
+.skill-mark { width: 24px; height: 24px; padding-top: 2px; }
+.skill-mark .mark { width: 22px; height: 22px; }
+.skill-mark .mark-circle { width: 26px; height: 14px; color: var(--subj); }
+.skill-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.skill-title { font-weight: 600; line-height: 1.35; }
+.skill-tag { font-weight: 500; font-size: var(--t-meta); color: var(--ink-3); margin-left: 8px; white-space: nowrap; }
+.skill-why { font-size: var(--t-ui-s); color: var(--ink-2); max-width: 66ch; }
+.skill-meta { font-size: var(--t-meta); color: var(--ink-3); max-width: 66ch; }
+.skill-act { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px 10px; }
+.skill-kind { font-size: var(--t-meta); color: var(--ink-2); white-space: nowrap; }
+.skill-review { margin-top: var(--s-6); max-width: 760px; font-size: var(--t-ui-s); }
+.skill-review summary { cursor: pointer; font-weight: 600; }
+.skill-review li { margin: var(--s-2) 0; }
+
+/* A sitting. */
+.skill-player .card { margin-top: var(--s-4); }
+.skill-q-count { font-family: var(--num); font-size: var(--t-meta); color: var(--ink-3); margin: 0 0 var(--s-2); }
+.skill-stem { font-size: var(--t-stem); font-weight: 600; line-height: 1.35; max-width: 34ch; margin: 0 0 var(--s-4); }
+.skill-notes { font-family: var(--num); font-size: var(--t-ui); letter-spacing: 0.02em; overflow-wrap: anywhere; margin: 0 0 var(--s-2); }
+.skill-board { max-width: 360px; margin: 0 0 var(--s-4); }
+.skill-choices { display: grid; gap: var(--s-2); max-width: 520px; }
+.skill-answer { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; max-width: 520px; }
+.skill-answer input { flex: 1 1 200px; min-width: 0; font: inherit; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--page); color: var(--ink); }
+.skill-input { margin: 0 0 var(--s-4); }
+.skill-input-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); margin-bottom: var(--s-2); }
+.skill-keys { overflow-x: auto; max-width: 100%; }
+.skill-verdict { display: flex; align-items: center; gap: 8px; font-weight: 600; margin: var(--s-4) 0 var(--s-2); }
+.skill-verdict .mark { width: 24px; height: 24px; flex: none; }
+.skill-verdict.is-right .mark { color: var(--correct); }
+.skill-verdict.is-wrong .mark { color: var(--incorrect); }
+
+/* Basketball counts. */
+.skill-count-form { display: grid; gap: var(--s-4); max-width: 520px; }
+.skill-count-set { border: 0; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
+.skill-count-set legend { font-weight: 600; margin-bottom: var(--s-2); }
+.skill-count { display: grid; grid-template-columns: minmax(0, 1fr) 110px; align-items: center; gap: var(--s-3); }
+.skill-count input { font: inherit; font-family: var(--num); padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--page); color: var(--ink); width: 100%; }
+.skill-radio { display: flex; gap: 8px; align-items: flex-start; font-size: var(--t-ui-s); }
+
+@media (max-width: 760px) {
+  .skill-now { grid-template-columns: 1fr; }
+  .skill-row { grid-template-columns: 24px minmax(0, 1fr); }
+  .skill-act { grid-column: 2; justify-content: flex-start; }
+  .skill-stem { font-size: var(--t-h3, 1.25rem); }
+  .skill-answer .btn { flex: 1 1 auto; }
+}
diff --git a/scripts/lib/skills-r3-fixture.js b/scripts/lib/skills-r3-fixture.js
new file mode 100644
index 0000000..7772013
--- /dev/null
+++ b/scripts/lib/skills-r3-fixture.js
@@ -0,0 +1,96 @@
+/**
+ * Shared set-up for the skills round 3 tests (scripts/skills-r3-*-test.js):
+ * a throwaway data file, every model key blanked, a clock the test moves, an
+ * app with the given routers mounted (the x-user header signs in), and
+ * learners enrolled in a chess, piano or basketball grade.
+ *
+ * Require this first, before anything that loads config/db.
+ */
+const os = require('os');
+const path = require('path');
+const fs = require('fs');
+const http = require('http');
+
+process.env.NODE_ENV = 'test';
+for (const k of Object.keys(process.env)) if (/_API_KEY$|_KEY$|ANTHROPIC|OPENROUTER|NVIDIA|GEMINI|MIMO|MODELFLARE|XKIRO/.test(k) && k !== 'NODE_ENV') process.env[k] = '';
+const tmp = path.join(os.tmpdir(), `skills-r3-${path.basename(require.main ? require.main.filename : 'x', '.js')}-${process.pid}.json`);
+process.env.DB_FILE = tmp;
+for (const k of ['SKILL_RECORD', 'SKILL_STAGE_TESTS', 'SKILL_STAGE_GATE', 'SKILL_DOSE', 'COVERAGE_GATE', 'COVERAGE_RULE', 'ADAPTIVE_TEACHING', 'ADMIN_EMAILS', 'OWNER_EMAIL',
+  'SKILL_MAINT_SHARE', 'SKILL_OVERLEARN', 'SKILL_CARRY_DAYS', 'SKILL_COLD_HOURS', 'SKILL_PROOF_DAYS']) delete process.env[k];
+
+const express = require('express');
+const db = require('../../config/db');
+const curriculum = require('../../config/curriculum');
+
+const HOUR = 3600 * 1000;
+const DAY = 24 * HOUR;
+// The clock: tests move it; everything that calls Date.now() sees it.
+const realNow = Date.now.bind(Date);
+let clock = Date.UTC(2026, 9, 1, 9, 0, 0);
+Date.now = () => clock;
+const at = (t) => { clock = t; return clock; };
+const later = (ms) => { clock += ms; return clock; };
+
+let failures = 0;
+function check(label, ok, detail) {
+  if (ok) { console.log(`  ok   ${label}`); return; }
+  failures++;
+  console.log(`  FAIL ${label}${detail === undefined ? '' : ` — ${JSON.stringify(detail).slice(0, 500)}`}`);
+}
+
+let n = 0;
+/** A learner enrolled in a grade, standing on `level` (default 1; 'final' for the grade's Final). */
+function learner(track, gradeId, level = 1, extra = {}) {
+  n += 1;
+  const grade = curriculum.getGrade(track, gradeId);
+  const final = grade.levels.find((l) => l.kind === 'graduation').level;
+  const user = db.insert('users', { email: `sk${n}-${process.pid}@example.test`, display_name: `Tester ${n}`, password_hash: 'x', streak: 0, xp: 0, onboarded: true });
+  const lvl = level === 'final' ? final : level;
+  const enrollment = db.insert('enrollments', {
+    user_id: user.id, track_id: track, grade_id: gradeId, target_level: grade.pathLength, current_level: lvl,
+    level_items: 0, levels_completed: lvl - 1, xp: 0, status: 'active', pending_checkpoint: null, placed_at: new Date(clock).toISOString(), ...extra,
+  });
+  return { user, enrollment, grade, final };
+}
+
+/** An app with the routers mounted under /api; the x-user header is the signed-in account. */
+function serve(routers) {
+  const app = express();
+  app.use(express.json());
+  app.use((req, res, next) => { req.user = db.byId('users', Number(req.headers['x-user'])) || null; next(); });
+  for (const r of routers) app.use('/api', r);
+  app.use('/api', (req, res) => res.status(404).json({ error: 'No such endpoint.' }));
+  return new Promise((resolve) => {
+    const server = app.listen(0, '127.0.0.1', () => {
+      const port = server.address().port;
+      const call = (method, url, body, uid) => new Promise((done, fail) => {
+        const data = body ? JSON.stringify(body) : null;
+        const req = http.request({ host: '127.0.0.1', port, path: url, method, headers: { 'content-type': 'application/json', 'x-user': String(uid || ''), ...(data ? { 'content-length': Buffer.byteLength(data) } : {}) } }, (res) => {
+          let text = '';
+          res.on('data', (c) => { text += c; });
+          res.on('end', () => { let json = null; try { json = JSON.parse(text); } catch { json = text; } done({ status: res.statusCode, json }); });
+        });
+        req.on('error', fail);
+        if (data) req.write(data);
+        req.end();
+      });
+      resolve({ get: (u, uid) => call('GET', u, null, uid), post: (u, b, uid) => call('POST', u, b || {}, uid), close: () => server.close() });
+    });
+  });
+}
+
+/** Load a module fresh, by its path from the repo root ('routes/skills'). */
+function fresh(mod) {
+  const p = require.resolve(path.join(__dirname, '..', '..', mod));
+  delete require.cache[p];
+  return require(p);
+}
+
+function done() {
+  try { fs.unlinkSync(tmp); } catch { /* not written */ }
+  try { fs.unlinkSync(`${tmp}.tmp`); } catch { /* not written */ }
+  console.log(failures ? `\n${failures} FAILED` : '\nPASS');
+  process.exit(failures ? 1 : 0);
+}
+
+module.exports = { db, curriculum, HOUR, DAY, at, later, now: () => clock, realNow, check, learner, serve, fresh, done, failures: () => failures };
diff --git a/scripts/skills-r3-record-test.js b/scripts/skills-r3-record-test.js
new file mode 100644
index 0000000..57217f9
--- /dev/null
+++ b/scripts/skills-r3-record-test.js
@@ -0,0 +1,134 @@
+/**
+ * Tests for the skill record store (staged skills round 3, patch
+ * 01-skill-record): services/skill-record.js, routes/skills.js, the
+ * skill_records collection and its place in the consent export and deletion.
+ *
+ *   node scripts/skills-r3-record-test.js
+ *
+ * Throwaway data file, keys blanked, no model call, no network.
+ */
+const F = require('./lib/skills-r3-fixture');
+const fs = require('fs');
+const path = require('path');
+
+const { db, check, learner, serve, fresh, HOUR, DAY, at, later, now } = F;
+const record = require('../services/skill-record');
+const sc = require('../services/skill-coverage');
+
+(async () => {
+  console.log('skills round 3, patch 01: the skill record store');
+
+  // ── the store and the consent rules ──
+  check('the skill_records collection exists', (() => { try { db.all('skill_records'); return true; } catch { return false; } })());
+  const consentSrc = fs.readFileSync(path.join(__dirname, '..', 'routes', 'consent.js'), 'utf8');
+  const known = consentSrc.slice(consentSrc.indexOf('const KNOWN_COLLECTIONS'), consentSrc.indexOf('];', consentSrc.indexOf('const KNOWN_COLLECTIONS')));
+  check('routes/consent.js lists skill_records, so the parent export and a deletion reach its rows', known.includes("'skill_records'"));
+  check('the progressions are in the app (content/skill-progressions)', sc.stagesFor('chess').length === 10 && sc.stagesFor('piano').length === 8 && sc.stagesFor('basketball').length === 7);
+  for (const s of sc.SUBJECTS) check(`${s}: every stage has an exit battery with tests, pass rules and sources`, sc.validate(s).ok, sc.validate(s).problems.slice(0, 2));
+
+  // ── off: every route answers 404 ──
+  const routes = fresh('routes/skills');
+  const app = await serve([routes]);
+  const chess = learner('chess', 'chess_rules_learner');
+  let r = await app.get(`/api/skills/record/${chess.enrollment.id}`, chess.user.id);
+  check('off: GET /api/skills/record answers 404', r.status === 404, r);
+  r = await app.get(`/api/skills/path/${chess.enrollment.id}`, chess.user.id);
+  check('off: GET /api/skills/path answers 404', r.status === 404, r);
+
+  process.env.SKILL_RECORD = 'on';
+  r = await app.get(`/api/skills/record/${chess.enrollment.id}`, chess.user.id);
+  check('on: the record names the stage of the grade (chess_rules_learner is CH1)', r.status === 200 && r.json.record.stage.id === 'CH1' && r.json.record.metrics.length === 4, r.json && r.json.record && r.json.record.stage);
+  check('...every metric unproven, nothing stored before a sitting', r.json.record.metrics.every((m) => m.status === 'unproven' && m.sittings === 0) && db.find('skill_records', (x) => x.user_id === chess.user.id).length === 0);
+  const other = learner('chess', 'chess_board_explorer');
+  r = await app.get(`/api/skills/record/${chess.enrollment.id}`, other.user.id);
+  check("someone else's enrollment is not found", r.status === 404, r.status);
+  r = await app.get(`/api/skills/record/${chess.enrollment.id}`, null);
+  check('signed out: 401', r.status === 401);
+  const math = learner('math', 'numbers_to_10');
+  r = await app.get(`/api/skills/record/${math.enrollment.id}`, math.user.id);
+  check('a subject that is not chess, piano or basketball has no skill record', r.status === 404);
+  r = await app.get(`/api/skills/path/${chess.enrollment.id}`, chess.user.id);
+  check('the path rows: none while the parts (02-04) are off or not applied', r.status === 200 && Array.isArray(r.json.nodes) && r.json.nodes.length === 0, r.json);
+
+  // ── sittings: cold or warm, day, source, confirmation ──
+  const uid = chess.user.id;
+  const id = 'CH1:check_mate_stalemate_id';
+  at(Date.UTC(2026, 9, 1, 9));
+  let out = record.sit(uid, { subject: 'chess', metricId: id, pass: true, source: 'board', kind: 'stage_test', score: 0.95, n: 20 });
+  check('a first sitting is cold and counts', out.counted && out.sitting.cold && out.row.status === 'unproven');
+  check('...and is stored with its day, source word, class, score and kind', out.sitting.day === '2026-10-01' && out.sitting.source_word === 'board' && out.sitting.source === 'exact' && out.sitting.score === 0.95 && out.sitting.kind === 'stage_test' && out.sitting.at_iso);
+  later(2 * HOUR);
+  out = record.sit(uid, { subject: 'chess', metricId: id, pass: true, source: 'board' });
+  check('a second sitting the same day is warm and does not count', !out.counted && !out.sitting.cold && /warm/.test(out.why), out.why);
+  at(Date.UTC(2026, 9, 2, 6));
+  record.practise(uid, { subject: 'chess', metricId: id, atTarget: true });
+  later(4 * HOUR);
+  out = record.sit(uid, { subject: 'chess', metricId: id, pass: true, source: 'board' });
+  check('four hours after practising it, a sitting is warm', !out.counted && out.row.status === 'unproven');
+  check('coldAt says when the next sitting will be cold (20 hours after practice, the next day)', record.coldAt(out.row, now()) >= Date.UTC(2026, 9, 3, 0) - 1);
+  at(Date.UTC(2026, 9, 3, 9));
+  out = record.sit(uid, { subject: 'chess', metricId: id, pass: true, source: 'board' });
+  check('cold passes on two different days prove the metric', out.counted && out.proved && out.row.status === 'proven', out.row.status);
+  const audit = record.auditStage(uid, 'chess', 'CH1').find((x) => x.id === id);
+  check('...and the proof re-derives from its sittings', audit.holds && audit.holds.ok, audit);
+
+  // Retaking until two lucky passes come cannot prove a metric.
+  const id2 = 'CH1:mate_in_1_unannounced';
+  at(Date.UTC(2026, 9, 1, 9)); record.sit(uid, { subject: 'chess', metricId: id2, pass: true, source: 'board' });
+  at(Date.UTC(2026, 9, 2, 9)); record.sit(uid, { subject: 'chess', metricId: id2, pass: false, source: 'board' });
+  at(Date.UTC(2026, 9, 3, 9)); out = record.sit(uid, { subject: 'chess', metricId: id2, pass: true, source: 'board' });
+  check('pass, miss, pass on three days is not proof (the belief)', out.counted && out.row.status === 'unproven', out.row.B);
+  at(Date.UTC(2026, 9, 4, 9)); out = record.sit(uid, { subject: 'chess', metricId: id2, pass: true, source: 'board' });
+  check('...one more cold pass is', out.row.status === 'proven', out.row.B);
+
+  // Sources: an estimate counts only confirmed; a source the metric does not list never counts.
+  const piano = learner('piano', 'piano_first_reader');
+  const pid = 'PI2:pieces';
+  at(Date.UTC(2026, 9, 1, 9)); out = record.sit(piano.user.id, { subject: 'piano', metricId: pid, pass: true, source: 'mic' });
+  check('a microphone take unconfirmed is recorded and does not count', !out.counted && out.sitting.source === 'estimate' && /confirmed/.test(out.why), out.why);
+  at(Date.UTC(2026, 9, 2, 9)); out = record.sit(piano.user.id, { subject: 'piano', metricId: pid, pass: true, source: 'mic', confirmed: true });
+  check('a confirmed microphone take counts', out.counted && out.sitting.confirmed);
+  at(Date.UTC(2026, 9, 3, 9)); out = record.sit(piano.user.id, { subject: 'piano', metricId: pid, pass: true, source: 'on-screen' });
+  check('on-screen keys never count for a metric that lists only MIDI and the microphone', !out.counted && /not a source this metric lists/.test(out.why), out.why);
+  at(Date.UTC(2026, 9, 4, 9)); out = record.sit(piano.user.id, { subject: 'piano', metricId: pid, pass: true, source: 'midi' });
+  check('MIDI counts, and with the confirmed microphone day it proves the metric', out.counted && out.row.status !== 'unproven', out.row.status);
+  const bb = learner('basketball', 'basketball_mini_starter');
+  at(Date.UTC(2026, 9, 1, 9)); out = record.sit(bb.user.id, { subject: 'basketball', metricId: 'BB1:layup_both_hands', pass: true, source: 'camera', confirmed: true });
+  check('basketball: a confirmed camera count counts where the metric lists the camera', out.counted && out.sitting.source === 'estimate');
+  const bb2 = learner('basketball', 'basketball_mini_player');
+  out = record.sit(bb2.user.id, { subject: 'basketball', metricId: 'BB2:form_shots_1m', pass: true, source: 'camera', confirmed: true });
+  check('...and never where it does not (BB2 form shots list only counts)', !out.counted, out.why);
+  out = record.sit(bb2.user.id, { subject: 'basketball', metricId: 'BB2:warmup_habit', pass: true, source: 'log' });
+  check('an attested-only metric is recorded and never counts', !out.counted && /attested/.test(out.why), out.why);
+  check('an unknown metric is refused', !!record.sit(uid, { subject: 'chess', metricId: 'CH1:nope', pass: true, source: 'board' }).error);
+
+  // Retention and the battery standing at exit.
+  const c2 = learner('chess', 'chess_rules_learner');
+  const st = record.stageFor('chess', 'chess_rules_learner');
+  at(Date.UTC(2026, 10, 1, 9));
+  for (const mt of st.metrics) record.sit(c2.user.id, { subject: 'chess', metricId: mt.id, pass: true, source: mt.id.endsWith('legal_game') ? 'games' : 'board' });
+  at(Date.UTC(2026, 10, 2, 9));
+  for (const mt of st.metrics) record.sit(c2.user.id, { subject: 'chess', metricId: mt.id, pass: true, source: mt.id.endsWith('legal_game') ? 'games' : 'board' });
+  let v = record.stageView(c2.user.id, c2.enrollment, now());
+  check('proven on two days, the stage still waits on its retention tests (CH1 asks again after 7+ days)', v.gate.unkept.length === 4 && v.gate.missing.length === 0 && v.metrics.every((m) => m.retention_due_at), v.gate);
+  at(Date.UTC(2026, 10, 10, 9));
+  for (const mt of st.metrics) record.sit(c2.user.id, { subject: 'chess', metricId: mt.id, pass: true, source: mt.id.endsWith('legal_game') ? 'games' : 'board' });
+  v = record.stageView(c2.user.id, c2.enrollment, now());
+  check('after the retention sittings every metric is kept', v.gate.unkept.length === 0 && v.metrics.every((m) => m.status === 'retained'), v.gate);
+  check('the knowledge side comes from the coverage gate of the stage\'s grade', v.knowledge.length === 1 && v.knowledge[0].id === 'chess_rules_learner' && v.gate.knowledge_ok === v.knowledge[0].complete);
+  at(Date.UTC(2026, 10, 19, 9));
+  v = record.stageView(c2.user.id, c2.enrollment, now());
+  check('a proof over 7 days old is stale: the battery must stand when the stage is left', v.gate.stale.length === 4 && v.metrics.every((m) => m.stale), v.gate.stale);
+
+  // Deletion reaches skill rows.
+  const consent = require('../routes/consent');
+  const kid = learner('piano', 'piano_keyboard_explorer');
+  record.sit(kid.user.id, { subject: 'piano', metricId: 'PI0:find_keys', pass: true, source: 'midi' });
+  const c = db.insert('parental_consents', { child_user_id: kid.user.id, status: 'active', parent_email: 'p@example.test', history: [] });
+  check('a child has a skill row before deletion', db.find('skill_records', (x) => x.user_id === kid.user.id).length === 1);
+  try { consent.deleteChild(db.byId('parental_consents', c.id), 'parent_request', 'test'); } catch (err) { check(`deleteChild ran (${err.message})`, false); }
+  check("deleting a child's account removes its skill records", db.find('skill_records', (x) => x.user_id === kid.user.id).length === 0);
+
+  app.close();
+  F.done();
+})().catch((err) => { console.error(err); process.exit(1); });
