+      const pos = C.parseFen(q.fen);
+      items.push({ kind: 'move', fen: q.fen, prompt: `${C.describe(pos)}\nFind the best move.`, key: { type: 'move', accepts: (q.accepts || [q.answer]).map(cleanSan) } });
+    }
+  }
