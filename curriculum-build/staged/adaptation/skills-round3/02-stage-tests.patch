+}
+
+module.exports = {
+  enabled,
+  rateAtLeast,
+  gradeItem,
+  itemsResult,
+  scoreTake,
+  cleanPlayed,
+  takeParts,
+  BUILDERS,
+  mirrorFen,
+  start,
+  answer,
+  take,
+  finish,
+  count,
+  countResult,
+  itemsForPage,
+  overview,
+  pathNode,
+  atFinal,
+  sittingForPage,
+};
