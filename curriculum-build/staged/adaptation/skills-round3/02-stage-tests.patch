+  const bank = require('../content/bank');
+  const items = [];
+  const avoid = new Set();
+  for (let i = 0; items.length < def.mates && i < 60; i++) {
+    const q = bank.generate({ skillId: 'chess_mate', difficulty: 1 + (i % 5), seed: `${seed}:mate:${i}`, avoid });
