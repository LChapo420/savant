+}
+
+// ── the open sitting ────────────────────────────────────────────────────────
+
+function itemsForPage(items) {
+  return items.map((it, index) => {
+    const { key, ...rest } = it;
+    return { index, ...rest };
+  });
+}
+
+/** What the page needs to run a sitting (never an answer key). */
+function sittingForPage(open) {
