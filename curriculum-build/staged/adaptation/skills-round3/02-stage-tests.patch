+      const parts = P.songParts(song, hands);
+      return { label: `${song.title}${hands === 'both' ? ', hands together' : ', right hand'}`, song: song.id, tempo: song.tempo, hands, target: parts.target, beats_per_bar: song.beatsPerBar };
