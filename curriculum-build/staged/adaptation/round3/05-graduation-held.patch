+    const anon = await app.call('GET', `/api/coverage/${b.enrollment.id}/held`, null, null);
+    check('signed out answers 401', anon.status === 401);
+  }
+
+  app.close();
+  done();
+})().catch((err) => { console.error(err); process.exit(1); });
