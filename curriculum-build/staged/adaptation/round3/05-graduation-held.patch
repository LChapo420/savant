+    check('the learner stays on the Final, marked held', e.status === 'active' && e.current_level === FINAL && !!e.coverage_held_at);
+    const r = await app.call('GET', `/api/coverage/${b.enrollment.id}/held`, null, b.user.id);
+    const p = r.body.plan;
