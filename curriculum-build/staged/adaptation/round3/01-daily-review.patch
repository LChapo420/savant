@@ -1066,6 +1066,28 @@ body:has(#item > .verdict .verdict-actions [data-act="next"]) main { padding-bot
   .path-actions .btn-lg { width: 100%; }
 }
 
+/* Today's review (staged round 3): its row at the head of the path, and its
+   page. The row is a level row with "Today" on the rail. */
+.node-review { border-bottom: 1px solid var(--line); margin-bottom: var(--s-2); }
+.node.node-review .badge { font-family: var(--font); font-size: 0.75rem; font-weight: 700; color: var(--subj); border-right: 3px solid var(--subj); padding-right: 12px; }
+.node.node-review.node-done .badge { border-right-color: var(--line-strong); }
+.review-now { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: var(--s-6) var(--s-10); align-items: start; margin-top: var(--s-6); }
+.review-lede { font-size: 1.125rem; line-height: 1.5; max-width: 60ch; margin: 0 0 var(--s-4); }
+.review-facts { margin: 0 0 var(--s-2); }
+.review-section { margin-top: var(--s-8); max-width: 760px; }
+.review-note { max-width: 64ch; margin: 0 0 var(--s-3); }
+.review-list { list-style: none; margin: 0; padding: 0; }
+.review-row { display: flex; align-items: center; gap: var(--s-2) var(--s-5); padding: 12px 0; border-top: 1px solid var(--line); }
+.review-row > span:first-child { flex: 1; min-width: 0; }
+.review-title { display: block; font-weight: 600; }
+.review-why { display: block; font-size: var(--t-meta); color: var(--ink-3); max-width: 64ch; }
+.review-kind { font-size: var(--t-meta); color: var(--ink-2); white-space: nowrap; }
+@media (max-width: 760px) {
+  .review-now { grid-template-columns: 1fr; }
+  .review-row { flex-wrap: wrap; }
+  .review-now .path-actions .btn-lg { width: 100%; }
+}
+
 /* The path, grouped by unit. A unit is a heading line with its level range
    and a row of tiny marks; only the unit you are in is open. */
 .units { display: grid; gap: 0; border-top: 1px solid var(--line); }
